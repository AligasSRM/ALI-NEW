{
  "name": "ali-new-browser-acceptance",
  "private": true,
  "version": "1.0.0",
  "description": "Browser acceptance tests for ALI-NEW static pages",
  "scripts": {
    "test:e2e": "playwright test --grep-invert @live",
    "test:e2e:report": "playwright show-report",
    "test:e2e:live": "playwright test tests/live-pages.spec.ts",
    "validate:core-inventory": "node scripts/validate-core-inventory.mjs",
    "validate:core-registry": "node scripts/validate-core-registry.mjs",
    "test:core-router": "node --test tests/core-route-resolver.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1"
  }
}
